  .divider{height:1px;background:var(--lavender-pale);margin:3rem 0;}
  .bullet-list{list-style:none;padding:0;}
  .bullet-list li{font-size:0.85rem;line-height:1.8;color:var(--ink-muted);padding-left:1.2rem;position:relative;margin-bottom:0.6rem;}
